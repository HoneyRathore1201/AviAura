# ==============================================================================
# Aviaura — Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   1) backend/.env   (for FastAPI server)
#   2) frontend/.env  (for Vite client)
#
# IMPORTANT: Never commit actual production API keys or credentials to Git.
# ==============================================================================

# ── Backend Configuration (backend/.env) ──────────────────────────────────────
APP_NAME=Aviaura
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Connection URI for MongoDB Atlas Cluster (M0 or dedicated instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aviaura

# ── Authentication & Security ─────────────────────────────────────────────────
# Generate a cryptographically secure key: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Google OAuth 2.0 Credentials ──────────────────────────────────────────────
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── AI Engines (Google Gemini & Groq LLaMA) ──────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview

# Groq Cloud API: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192

# ── Weather & Geospatial ──────────────────────────────────────────────────────
# OpenWeatherMap API: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
OPENWEATHERMAP_UNITS=metric

# ── Frontend Configuration (frontend/.env) ────────────────────────────────────
# In local development, leave VITE_API_BASE_URL empty to use Vite's built-in proxy.
# For production builds, point to your deployed backend URL (e.g., https://api.aviaura.com).
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
