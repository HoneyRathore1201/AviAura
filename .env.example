# Aviaura — copy this file to .env (and later backend/.env).
# Do not commit real keys. Never put secrets in the frontend.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_NAME=Aviaura
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aviaura

# ── Auth (you generate these locally — not from a vendor) ────────────────────
# openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Google Gemini (Google AI Studio) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview

# ── OpenWeatherMap ───────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
OPENWEATHERMAP_UNITS=metric

# ── Optional frontend (Vite) ─────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000
# VITE_APP_NAME=Aviaura
